<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>BenchmarkStart</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="BenchmarkDotNet" Version="0.16.0-preview.2" />
      <None Include="..\DomainClass\appsettings.json" Link="appsettings.json">
      	<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>    
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\DomainClass\DomainClass.csproj" />
      <ProjectReference Include="..\Generators\Generators.csproj" />
      <ProjectReference Include="..\Strategies\Strategies.csproj" />
    </ItemGroup>

</Project>
